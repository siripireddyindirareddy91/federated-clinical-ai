# Development default uses SQLite. Set PostgreSQL for durable shared storage.
DATABASE_URL=sqlite:///./medifed.db
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000
API_URL=http://127.0.0.1:8000
# Required for non-demo deployments. Demo mode intentionally seeds public synthetic accounts.
ADMIN_EMAIL=
ADMIN_PASSWORD=
